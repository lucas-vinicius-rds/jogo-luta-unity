.selection { flex-grow: 1; background-color: rgb(17,17,20); color: rgb(242,239,230); padding: 36px 44px; }
.masthead { height: 150px; flex-shrink: 0; border-left-width: 10px; border-left-color: rgb(239,41,51); padding-left: 24px; }
.eyebrow { color: rgb(244,200,53); font-size: 24px; letter-spacing: 5px; }
.heading { font-size: 72px; -unity-font-definition: resource("UI/Fonts/BarlowCondensed-Bold"); height: 90px; }
.body { flex-grow: 1; flex-direction: row; min-height: 0; margin-top: 20px; margin-bottom: 25px; }
.hero { width: 34%; background-color: rgb(24,24,28); transition-property: opacity; transition-duration: .16s; }
.browser { width: 46%; margin-left: 25px; margin-right: 25px; }
.cards { flex-direction: row; flex-wrap: wrap; }
.card { width: 30%; height: 195px; margin: 5px; padding: 0; border-width: 2px; border-color: rgb(52,52,58); border-radius: 0; background-color: rgb(28,28,32); color: rgb(240,238,230); transition-property: border-color, background-color; transition-duration: .09s; }
.card Image { flex-grow: 1; width: 100%; }
.card Label { font-size: 24px; height: 40px; padding-left: 8px; -unity-text-align: middle-left; }
.card.focused { border-color: rgb(245,201,50); background-color: rgb(184,31,40); }
.rival { flex-grow: 1; background-color: rgb(24,24,28); }
.rival-panel { flex-grow: 1; min-width: 0; background-color: rgb(24,24,28); }
.rival-label { font-size: 24px; color: rgb(245,201,50); height: 52px; padding: 10px; }
.stats { font-size: 22px; color: rgb(183,181,175); margin-top: 8px; white-space: normal; }
.footer { min-height: 170px; flex-shrink: 0; flex-direction: row; align-items: center; border-top-width: 2px; border-top-color: rgb(61,61,66); }
.identity { flex-grow: 1; width: 38%; }
.name { font-size: 60px; -unity-font-definition: resource("UI/Fonts/BarlowCondensed-Bold"); }
.description { font-size: 25px; white-space: normal; max-width: 650px; }
.footer Button { font-size: 24px; min-height: 65px; padding: 12px; margin-left: 12px; border-width: 0; border-radius: 0; background-color: rgb(45,45,50); color: rgb(242,239,230); }
.footer .confirm { background-color: rgb(222,35,47); }
.stage .browser { width: 27%; }
.stage .hero { width: 70%; }
.stage .rival { display: none; }
.stage .rival-panel { display: none; }
.stage .stats { display: none; }
.stage .card { width: 95%; height: 105px; flex-direction: row; }
.stage .card Image { width: 42%; }
.stage .card Label { flex-grow: 1; white-space: normal; }
.selection-background, .selection-shade { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.selection-shade { background-color: rgba(8,10,16,.80); }
.selection { padding: 26px 40px; }
.masthead { border-left-color: rgb(47,207,247); height: 130px; }
.heading { font-size: 64px; }
.eyebrow { color: rgb(255,175,58); }
.hero, .rival, .rival-panel { background-color: rgba(15,19,27,.8); }
.card { background-color: rgba(20,26,35,.95); border-color: rgb(54,77,94); }
.card Label { font-size: 22px; white-space: normal; height: 54px; }
.card.focused, .card:hover { border-color: rgb(50,213,251); background-color: rgb(37,69,90); }
.footer { min-height: 180px; }
.identity { width: 36%; }
.name { font-size: 52px; }
.description { font-size: 23px; }
.footer Button { font-size: 22px; max-width: 20%; white-space: normal; border-width: 1px; border-color: rgb(65,91,112); }
.footer Button:hover, .footer Button:focus { border-color: rgb(255,208,100); background-color: rgb(37,77,99); }
.footer .confirm { background-color: rgb(196,49,27); border-color: rgb(255,165,59); }
