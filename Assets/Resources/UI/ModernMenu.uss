.undfight-root { flex-grow: 1; background-color: rgb(7, 22, 28); }
.page { flex-grow: 1; min-height: 720px; align-items: center; justify-content: center; padding: 32px 24px; background-color: rgba(3, 15, 22, .76); }
.title-group { align-items: center; margin-bottom: 24px; }
.title { color: rgb(247, 238, 212); font-size: 70px; -unity-font-style: bold; letter-spacing: 7px; }
.caption { color: rgb(235, 182, 92); font-size: 15px; -unity-font-style: bold; letter-spacing: 3px; margin-top: 6px; white-space: normal; -unity-text-align: middle-center; }
.actions { width: 440px; max-width: 94%; align-items: stretch; }
.button { flex-shrink: 0; height: 54px; margin: 5px 0; padding: 8px 18px; border-width: 1px; border-color: rgba(138, 217, 220, .36); border-radius: 6px; color: rgb(237, 244, 235); font-size: 17px; -unity-font-style: bold; letter-spacing: 1px; white-space: normal; -unity-text-align: middle-center; }
.button:hover, .button:focus { background-color: rgb(37, 99, 94); border-color: rgb(248, 202, 120); color: white; }
.button:active { background-color: rgb(25, 67, 63); }
.primary { background-color: rgb(207, 151, 64); color: rgb(13, 31, 32); border-color: rgb(249, 210, 139); }
.secondary, .small { background-color: rgb(19, 49, 53); }
.ghost { background-color: rgba(12, 29, 35, .75); color: rgb(169, 190, 185); }
.difficulty-row { flex-direction: row; align-items: center; justify-content: center; margin-bottom: 8px; }
.small { height: 42px; width: 52px; font-size: 23px; margin: 2px 8px; }
.difficulty-label, .setting-label { color: rgb(188, 227, 221); font-size: 16px; -unity-font-style: bold; letter-spacing: 1px; }
.difficulty-label { min-width: 175px; -unity-text-align: middle-center; }
.setting-label { margin: 6px 0 4px; }
.volume-slider { margin-bottom: 22px; }
.footer { color: rgb(171, 203, 192); font-size: 13px; white-space: normal; -unity-text-align: middle-center; margin-top: 20px; max-width: 94%; }
