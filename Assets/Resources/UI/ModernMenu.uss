.undfight-root { flex-grow: 1; background-color: rgb(12,14,20); }
.page { flex-grow: 1; min-height: 690px; align-items: center; justify-content: center; padding: 24px 40px; background-color: rgba(8,10,16,.78); }
.title-group { align-items: center; margin-bottom: 20px; }
.title { color: rgb(255,243,220); font-size: 62px; -unity-font-definition: resource("UI/Fonts/BarlowCondensed-Bold"); letter-spacing: 2px; }
.caption { color: rgb(71,220,250); font-size: 16px; -unity-font-style: bold; letter-spacing: 2px; margin-top: 6px; white-space: normal; -unity-text-align: middle-center; }
.brand-logo { width: 560px; max-width: 85%; height: 210px; margin-bottom: 10px; }
.actions { width: 480px; max-width: 94%; align-items: stretch; }
.button { flex-shrink: 0; min-height: 52px; margin: 5px 0; padding: 10px 22px; border-width: 1px; border-left-width: 5px; border-color: rgb(61,81,95); border-radius: 0; color: rgb(242,247,250); font-size: 23px; -unity-font-definition: resource("UI/Fonts/BarlowCondensed-Bold"); letter-spacing: 1px; white-space: normal; -unity-text-align: middle-left; }
.primary { background-color: rgb(206,53,26); border-color: rgb(255,180,48); color: white; }
.secondary, .small { background-color: rgb(17,36,49); border-left-color: rgb(41,204,244); }
.ghost { background-color: rgba(14,17,24,.9); color: rgb(187,200,212); }
.button:hover, .button:focus { background-color: rgb(34,77,96); border-color: rgb(255,225,127); color: white; }
.button:active { background-color: rgb(155,48,26); }
.difficulty-row { flex-direction: row; align-items: center; justify-content: center; margin-bottom: 6px; }
.small { min-height: 40px; width: 52px; font-size: 23px; margin: 2px 8px; padding: 4px; -unity-text-align: middle-center; }
.difficulty-label, .setting-label { color: rgb(169,225,240); font-size: 16px; -unity-font-style: bold; }
.difficulty-label { min-width: 190px; -unity-text-align: middle-center; }
.setting-label { margin: 6px 0 4px; }
.volume-slider { margin-bottom: 14px; }
.footer { color: rgb(187,200,212); font-size: 14px; white-space: normal; -unity-text-align: middle-center; margin-top: 16px; max-width: 94%; }
