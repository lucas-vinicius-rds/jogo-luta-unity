.undfight-root { flex-grow: 1; background-color: rgba(3, 12, 23, 0.28); background-size: cover; background-position: center; }
.page { flex-grow: 1; align-items: center; justify-content: center; padding-top: 8%; padding-bottom: 6%; background-color: rgba(5, 21, 38, 0.42); }
.title-group { align-items: center; margin-bottom: 52px; }
.title { color: rgb(238, 247, 255); font-size: 58px; unity-font-style: bold; letter-spacing: 5px; }
.caption { color: rgb(78, 202, 244); font-size: 17px; unity-font-style: bold; letter-spacing: 3px; margin-top: 6px; }
.actions { width: 430px; max-width: 78%; align-items: stretch; }
.button { height: 58px; margin-top: 8px; margin-bottom: 8px; padding-left: 10px; padding-right: 10px; padding-top: 0; padding-bottom: 0; border-top-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-right-width: 1px; border-top-color: rgba(138, 217, 255, 0.36); border-bottom-color: rgba(138, 217, 255, 0.36); border-left-color: rgba(138, 217, 255, 0.36); border-right-color: rgba(138, 217, 255, 0.36); border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px; color: rgb(240, 248, 255); font-size: 18px; unity-font-style: bold; letter-spacing: 1px; white-space: normal; -unity-text-align: middle-center; }
.button:hover { background-color: rgb(31, 123, 166); border-top-color: rgb(151, 231, 255); border-bottom-color: rgb(151, 231, 255); border-left-color: rgb(151, 231, 255); border-right-color: rgb(151, 231, 255); }
.primary { background-color: rgb(19, 111, 158); }
.secondary { background-color: rgb(14, 51, 79); }
.ghost { background-color: rgba(7, 26, 43, 0.42); color: rgb(164, 196, 215); }
.difficulty-row { flex-direction: row; align-items: center; justify-content: center; margin-bottom: 8px; }
.small { width: 58px; font-size: 28px; margin-left: 6px; margin-right: 6px; background-color: rgb(14, 51, 79); }
.difficulty-label, .setting-label { color: rgb(188, 227, 246); font-size: 16px; unity-font-style: bold; letter-spacing: 1px; }
.difficulty-label { min-width: 175px; -unity-text-align: middle-center; }
.setting-label { margin-top: 6px; margin-bottom: 4px; }
.volume-slider { margin-bottom: 22px; }
.footer { display: none; }
